{
    "app":{
        "cfengine":"lucee-light@7.0.3+43",
        "sessionCookieSameSite":"Lax",
        "sessionCookieSecure":"true",
        "sessionCookieHTTPOnly":"true"
    },
    "cfconfig":{
        "file":".cfconfig.json"
    },
    "env":{
        "LUCEE_EXTENSIONS":"671B01B8-B3B3-42B9-AC055A356BED5281;version=${DB_BUNDLEVERSION},D062D72F-F8A2-46F0-8CBC91325B2F067B;version=6.5.3,37C61C0A-5D7E-4256-8572639BE0CF5838;version=3.0.0.14,B737ABC4-D43F-4D91-8E8E973E37C40D1B;version=3.0.1.1${OTHER_EXTENSIONS:''}",
        "LUCEE_APPLICATION_LISTENER":"modern",
        "LUCEE_APPLICATION_MODE":"curr2root",
        "LUCEE_APPLICATION_PATH_CACHE_TIMEOUT":300,
        "LUCEE_QUEUE_MAX":10
    },
    "jvm":{
        "heapSize":"${JAVAHEAP}",
        "minHeapSize":"${JAVAHEAP}",
        "javaVersion":"openjdk21_jre_x64_${OS}_hotspot_jdk-21.0.10+7",
        "args":"-Duser.timezone=UTC"
    },
    "name":"POGO Tracker",
    "openbrowser":"false",
    "openBrowserUrl":"http://${HTTP_HOST}:${HTTP_PORT}",
    "runwar":{
        "UndertowOptions":{
            "MAX_ENTITY_SIZE":52428800
        }
    },
    "trayEnable":"false",
    "web":{
        "host":"${HTTP_HOST}",
        "mimeTypes":{
            "xml":"application/xml"
        },
        "rewrites":{
            "enable":"true"
        },
        "directoryBrowsing":"false",
        "http":{
            "enable":"true",
            "port":"${HTTP_PORT}"
        },
        "rules":[
            "warm-up-server(urls={'/main/warmup'}, requestStrategy=queue, async=false, timeoutSeconds=300)",
            "path-prefix-nocase(/lucee/) -> ip-access-control[default-allow=false, acl={'127.0.0.* allow', '::1 allow'}, failure-status=404]",
            "path(/WebSocket.cfc) -> done",
            "path(/robots.txt) -> rewrite('/includes/robots.txt')",
            "path(/sitemap.xml) -> rewrite('/includes/sitemap.xml')",
            "regex-nocase('.*(box\\.json|Dockerfile|cfconfig\\.json|server\\.json)') or path-suffix-nocase(.env) or path-suffix-nocase(.md) or path-prefix-nocase(/includes/assets/) or path-suffix-nocase(.cfc) or path-prefix-nocase(/.well-known/) or path-prefix-nocase('/app') or path-prefix-nocase(/views/) or path-prefix-nocase(/layouts/) or path-prefix-nocase(/database/) or path-prefix-nocase(/scripts/) -> set-error(404)",
            "samesite-cookie(mode=Lax)"
        ],
        "maxRequests":"50",
        "webroot":"",
        "useProxyForwardedIP":"true",
        "websocket":{
            "enable":"true",
            "listener":"WebSocket.cfc"
        }
    }
}
