{
    "editor.formatOnSave": true,
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "files.exclude": {
        "**/.git": true,
        "app/includes/node_modules/": true,
        "app/includes/test-results/": true,
        "app/includes/playwright-report/": true
    },
    "prettier.tabWidth": 4,
    "prettier.singleQuote": true,
    "prettier.printWidth": 120,
    "github.copilot.enable": {
        "*": false
    },
    "search.exclude": {
        "app/includes/build/": true,
        "**/.secrets": true,
        "**/.env": true,
        "*.min.js": true,
        "app/includes/package-lock.json": true,
        "app/coldbox/": true,
        "app/modules/**": true,
        "!app/modules/config/**": true,
        "!app/includes/js/modules/**": true
    },
    "workbench.tree.enableStickyScroll": false,
    "editor.stickyScroll.enabled": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "workbench.iconTheme": "material-icon-theme",
    "eslint.workingDirectories": ["./app/includes"],
    "eslint.options": {
        "overrideConfigFile": "eslint.config.js"
    },
    "eslint.validate": ["javascript", "css"],
    "prettier.trailingComma": "es5",
    "files.eol": "\n",
    "gitlens.ai.enabled": false,
    "gitlens.plusFeatures.enabled": false
}
